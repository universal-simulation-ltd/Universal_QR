<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ⚠️ Universal QR is OUT of the Android shared sign-in, on purpose.
         Play signs QR with its own Google-generated key (SHA-256 FA:57:01…),
         not the suite key the other apps share (Universal PDF's, 6B:1E:F2:0F…).
         The choice was missed when the Play app was created, and 1.0.0 went
         live before anyone noticed, so the key can't be changed now.
         The SDK's manifest declares SUITE_AUTH at protectionLevel="signature",
         and Android refuses to install a second app that declares that
         permission under a different key (INSTALL_FAILED_DUPLICATE_PERMISSION).
         So QR 1.0.0 could not be installed next to any other suite app from
         Play, and the other way round.
         These lines strip the permission and the session provider that is
         guarded by it out of the merged manifest. QR then installs next to
         everything and keeps its own session. Its calls to peers fail with a
         SecurityException, which SuiteAuthStore.callPeer already swallows.
         The switcher (<queries>) and the OAuth callback activity are kept.
         Don't remove these lines unless QR moves to a new package name
         signed with the suite key. -->
    <permission
        android:name="uk.co.unisim.suite.permission.SUITE_AUTH"
        tools:node="remove" />
    <uses-permission
        android:name="uk.co.unisim.suite.permission.SUITE_AUTH"
        tools:node="remove" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <provider
            android:name="uk.co.unisim.sdk.SuiteAuthProvider"
            tools:node="remove" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The Scan tab's camera. Capacitor's BridgeWebChromeClient turns the
         WebView's getUserMedia request into a runtime CAMERA request, and the
         OS remembers the answer - but ONLY if the permission is declared here.
         Android denies a runtime request for an undeclared permission
         instantly and shows no dialog, which is why scanning failed on Android
         with no visible prompt until 2026-09-04. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Declared not-required so the Play listing does not filter out devices
         without a camera: every other tab works fine on one. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
